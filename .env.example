# Copy to .env.local and fill in real values. Never commit .env.local.

# Stripe — https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Public site URL used for Stripe success/cancel redirects.
# Local: http://localhost:3000
# Production: set this to your real domain, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_jwt

# Brevo (email) — https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key
FROM_EMAIL=bansri <hello@yourdomain.com>
REPLY_TO=hello@yourdomain.com
TO_EMAIL=recipient@example.com

# Admin: run supabase/schema.sql then catalog-migration.sql
# update public.profiles set role = 'admin' where email = 'you@example.com';
# Open /admin after signing in.
